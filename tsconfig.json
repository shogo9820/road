{
  "compilerOptions": {
    // 📂 【最適化】現在のフォルダ構成に合わせたレイアウト設定
    "rootDir": "./",                             /* プロジェクトのルート（全JS/TSファイルの基点） */
    "outDir": "./dist",                          /* コンパイル後の出力先フォルダ */

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "types": [],

    // 🤝 JavaScriptファイルを混ぜて動かすための設定
    "allowJs": true,                             /* JavaScriptファイルの存在を許す */
    "checkJs": false,                            /* 既存のJSファイル自体の型チェックはまだしない */
    "esModuleInterop": true,                     /* 既存のJSライブラリをインポートしやすくする */

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // 🛡️ 移行をスムーズにするため、厳しい型チェックを一旦「false」にする
    "strict": false,                             /* ★最初はユルく始めてエラー爆発を防ぐ */
    "noUncheckedIndexedAccess": false,           /* 配列やオブジェクトの厳しい未定義チェックを一時OFF */
    "exactOptionalPropertyTypes": false,         /* オプショナルプロパティの厳密チェックを一時OFF */

    // Recommended Options
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,               /* 移行期は型 elision を許容するためfalse推奨 */
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  // 🎯 【最適化】コンパイル対象と除外対象を現在のフォルダ構成に指定
  "include": [
    "server.ts",
    "./master/**/*",
    "./public/**/*",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public/squares/**/*" 
  ]
}
